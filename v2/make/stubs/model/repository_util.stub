package {{PackageName}}

import (
	"context"
	"errors"
	"fmt"

	"gorm.io/gorm"
	"gorm.io/gorm/clause"

	"{{ModelsImportPath}}"
)

// Get 按主键查询；记录不存在时 found 为 false 且 err 为 nil，其余数据库错误原样上抛。
func (r *Repository) Get(ctx context.Context, id int64) ({{VariableName}} {{ModelPackageName}}.{{StructName}}, found bool, err error) {
	err = r.mdbCtx(ctx).First(&{{VariableName}}, id).Error
	if errors.Is(err, gorm.ErrRecordNotFound) {
		return {{VariableName}}, false, nil
	}
	if err != nil {
		return {{VariableName}}, false, fmt.Errorf("get {{VariableName}} %d: %w", id, err)
	}
	return {{VariableName}}, true, nil
}

// ExistsByID 判断主键是否存在。
func (r *Repository) ExistsByID(ctx context.Context, id int64) (bool, error) {
	var count int64
	if err := r.mdbCtx(ctx).Model(&{{ModelPackageName}}.{{StructName}}{}).Where("id = ?", id).Count(&count).Error; err != nil {
		return false, fmt.Errorf("count {{VariableName}} %d: %w", id, err)
	}
	return count > 0, nil
}

// All 返回全部记录。
func (r *Repository) All(ctx context.Context) ({{VariableNamePlural}} []{{ModelPackageName}}.{{StructName}}, err error) {
	if err = r.mdbCtx(ctx).Find(&{{VariableNamePlural}}).Error; err != nil {
		return nil, fmt.Errorf("list {{VariableNamePlural}}: %w", err)
	}
	return {{VariableNamePlural}}, nil
}

// CreateOrUpdate 按 primaryKey 冲突时更新 updateColumns，否则插入。
func (r *Repository) CreateOrUpdate(ctx context.Context, entity *{{ModelPackageName}}.{{StructName}}, primaryKey string, updateColumns []string) error {
	return r.mdbCtx(ctx).Clauses(clause.OnConflict{
		Columns:   []clause.Column{{Name: primaryKey}},
		DoUpdates: clause.AssignmentColumns(updateColumns),
	}).Create(entity).Error
}
